# native/.env — copy this file to native/.env and fill it in. Not committed.
# EXPO_PUBLIC_* values are inlined into the JS bundle at build time, so they
# are public by design; they stay out of git so each environment sets its own.
# CI: android-release.yml writes this file from GitHub secrets; iOS builds read
# the EAS "production" environment. Keep the values identical everywhere.

# Supabase project URL and anon/publishable key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# videx-api Worker base URL.
EXPO_PUBLIC_API_PROXY_URL=
# Sentry DSN; leave empty to keep the SDK disabled (local dev).
EXPO_PUBLIC_SENTRY_DSN=

# Google Sign-In (Growth S3). Google Cloud Console → project videx-3063b →
# APIs & Services → Credentials.
# The Web application client id: the audience of the id token Supabase checks.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# The iOS client id (ends .apps.googleusercontent.com). app.config.js derives
# the iOS URL scheme from it; without it the Google button is hidden on iOS.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
